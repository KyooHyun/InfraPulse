MYSQL_ROOT_PASSWORD=example
MYSQL_DATABASE=finops
MYSQL_USER=finops_user
MYSQL_PASSWORD=finops_pass
MYSQL_HOST=mysql
MYSQL_PORT=3306
API_HOST=0.0.0.0
API_PORT=8000

# JWT 서명 키 — 운영 환경에서는 반드시 강력한 랜덤 값으로 교체할 것
# 생성 예시: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme-replace-with-strong-random-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
